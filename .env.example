# Server-side only. Never prefix model secrets with VITE_.
STARSCORE_MODEL_BASE_URL=https://model-provider.example/v1
STARSCORE_MODEL_NAME=your-model-name
STARSCORE_MODEL_API_KEY=replace-me
STARSCORE_MODEL_TIMEOUT_MS=15000

# Comma-separated browser/App origins allowed to call a separately hosted API.
STARSCORE_CORS_ORIGINS=https://localhost,https://starscore.example

# Android build only: must be an HTTPS URL reachable by the physical device.
# VITE_API_BASE_URL=https://api.starscore.example
